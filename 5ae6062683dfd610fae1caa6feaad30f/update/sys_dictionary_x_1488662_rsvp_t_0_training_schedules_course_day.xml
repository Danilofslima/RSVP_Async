        <audit>false</audit>
        <calculation><![CDATA[(function calculatedFieldValue(current) {

    // Safely get field values and handle null/undefined
    var courseName = current.course_name.course_name.toString(); // Get course name or empty string
    var trainingDay = current.training_day.toString(); // Get training day or empty string

    var formattedDate = "";

    // Format the date if trainingDay is not empty
    if (trainingDay) {
        // Split the date into components
        var parts = trainingDay.split("-"); // ["2025", "01", "29"]
        if (parts.length === 3) {
            // Rearrange and join in the desired format
            formattedDate = parts[2] + "/" + parts[1] + "/" + parts[0]; // "29/01/2025"
        }
    }

    // Concatenate course name with formatted date
    var fullString = courseName + " (" + formattedDate + ")";

    // Return the calculated value
    return fullString;

})(current);
]]></calculation>
