        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue == '') {
        return;
    }

    // alert(g_user.userID.toString()); // Corrigido typo
    // alert(newValue);

    var ga = new GlideAjax('MaxOfThreeSI');
    ga.addParam('sysparm_name', 'checkUserCourse');
    ga.addParam('sysparm_user', g_user.userID.toString()); 
    ga.addParam('sysparm_course', newValue);

    ga.getXMLAnswer(function(answer) {
		// alert('Server response: ' + answer);
        if (answer && answer !== 'ok') {
            alert('You have tried to enroll in this Course 3 times already. Unfortunally you can not apply again.');
            g_form.clearValue('course_day2'); // Limpa o campo correto
        } else {
            g_form.addInfoMessage('This Course available to  you.')
        }
    });
}
]]></script>
