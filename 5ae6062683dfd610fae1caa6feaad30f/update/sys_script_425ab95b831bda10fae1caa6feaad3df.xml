        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    var today = new Date(); // Obtém a data atual no formato correto do ServiceNow
    today.setHours(0, 0, 0, 0);

    var trainingDayStr = current.training_day.getDisplayValue();
    var parts = trainingDayStr.split("/"); // Divide a string no formato dd/MM/yyyy
    var deadLine = new Date(parts[2], parts[1] - 1, parts[0] - 1); // Converte para Date no formato yyyy-MM-dd

    if (deadLine >= today) {
        gs.info('está ok');
		current.dead_line_reached = false;
		current.update();
    } else {
        current.dead_line_reached = true;
		current.update();
		// current.setValue("dead_line_reached", true);
        gs.info('Passou a data de inscrição. Mudar flag pra true');
    }

})(current, previous);]]></script>
