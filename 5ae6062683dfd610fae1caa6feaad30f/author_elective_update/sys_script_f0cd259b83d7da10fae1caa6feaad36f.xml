        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    // Converte `training_day` para GlideDateTime
    var trainingDay = new GlideDateTime(current.training_day);

    // Define a data limite para inscrição (um dia antes do treinamento)
    var deadline = new GlideDateTime(trainingDay);
    deadline.addDaysLocalTime(-1); // Subtrai 1 dia

    // Atualiza o campo 'dead_line' com a data calculada
    current.setValue("dead_line", deadline);

})(current, previous);
]]></script>
